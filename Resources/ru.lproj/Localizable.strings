/* Отсчёт со строчной: прописную ставит то место, где строится подпись.
   Сокращения намеренные: в шапку панели помещается «через 12 мин», но
   не полное слово с падежом, а сокращение не склоняется ни в каком языке. */
"now" = "идёт сейчас";
"any moment" = "вот-вот";
"tomorrow" = "завтра";
