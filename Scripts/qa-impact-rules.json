{
  "schema_version": 1,
  "matrix_path": "knowledge-base/13-qa/behavioral-qa-matrix.md",
  "release_evidence_directory": "knowledge-base/13-qa/release-evidence",
  "tracked_source_globs": [
    "Sources/Impuls/**/*.swift",
    "Sources/ImpulsLauncher/*.swift",
    "Resources/*.entitlements",
    "Scripts/bundle.sh",
    "Scripts/dmg.sh",
    ".github/workflows/release.yml"
  ],
  "exemptions": [
    {
      "source_globs": [
        "Sources/Impuls/Services/VersionTelemetryScheduler.swift"
      ],
      "reason": "The scheduler only proposes an attempt on a bounded cadence and carries no policy of its own; it has no user-facing Behavioral QA row and is governed by VersionTelemetrySchedulerTests. VersionTelemetryService.swift moved out of this exemption in 1.4.16: its send/throttle logic remains deterministic and test-owned, but the file now also backs the REL-07 diagnostics display below, so it is mapped rather than exempted."
    },
    {
      "source_globs": [
        "Sources/Impuls/Services/FeedbackService.swift"
      ],
      "reason": "Feedback URL construction has no platform/hardware Behavioral QA row; it is governed by FeedbackServiceTests and the feedback privacy boundary."
    },
    {
      "source_globs": [
        "Sources/Impuls/App/Strings.swift"
      ],
      "reason": "Localization key plumbing is enforced by localization CI rather than a hardware/TCC Behavioral QA scenario. The path was corrected from a file that does not exist, so the exemption now applies to the real lookup helper. That helper carries no language policy of its own; the in-app language choice lives in AppLanguageService and is routed to UI-07."
    }
  ],
